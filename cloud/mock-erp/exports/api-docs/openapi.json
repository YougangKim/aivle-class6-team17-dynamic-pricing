  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryRecord": {
        "properties": {
          "inventory_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Inventory Id"
          },
          "store_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Store Id"
          },
          "product_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Product Id"
          },
          "lot_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Lot Id"
          },
          "current_date": {
            "type": "string",
            "format": "date",
            "title": "Current Date"
          },
          "manufacture_date": {
            "type": "string",
            "format": "date",
            "title": "Manufacture Date"
          },
          "expiry_date": {
            "type": "string",
            "format": "date",
            "title": "Expiry Date"
          },
          "days_to_expiry": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days To Expiry"
          },
          "inbound_qty": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Inbound Qty"
          },
          "daily_sold_qty": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Daily Sold Qty"
          },
          "daily_waste_qty": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Daily Waste Qty"
          },
          "current_stock_qty": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Current Stock Qty"
          },
          "reserved_qty": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Reserved Qty"
          },
          "available_qty": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Qty"
          },
          "freshness_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Freshness Score"
          },
          "unit_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unit Cost"
          },
          "unit_price": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unit Price"
          },
          "discount_rate": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Discount Rate"
          },
          "discount_price": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount Price"
          },
          "disposal_candidate": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Y",
                  "N"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Disposal Candidate"
          },
          "inventory_status": {
            "type": "string",
            "maxLength": 30,
            "title": "Inventory Status",
            "default": "ON_SALE"
          },
          "waste_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Waste Reason"
          },
          "weight_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Weight Kg"
          }
        },
        "type": "object",
        "required": [
          "inventory_id",
          "store_id",
          "product_id",
          "lot_id",
          "current_date",
          "manufacture_date",
          "expiry_date",
          "inbound_qty",
          "daily_sold_qty",
          "daily_waste_qty",
          "current_stock_qty",
          "reserved_qty",
          "unit_cost",
          "unit_price",
          "discount_rate",
          "weight_kg"
        ],
        "title": "InventoryRecord"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}